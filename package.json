{
	"name": "pi-working-phrase",
	"version": "0.2.1",
	"description": "A tiny Pi extension that replaces Pi's working status with shuffled phrases, a colored spinner, and an animated shine gradient.",
	"type": "module",
	"license": "MIT",
	"author": "Brandon Mathis",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/brandonmathis/pi-working-phrase.git"
	},
	"bugs": {
		"url": "https://github.com/brandonmathis/pi-working-phrase/issues"
	},
	"homepage": "https://github.com/brandonmathis/pi-working-phrase#readme",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi-coding-agent",
		"working-status",
		"tui"
	],
	"engines": {
		"node": ">=20.6.0"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		],
		"video": "https://raw.githubusercontent.com/brandonmathis/pi-working-phrase/main/docs/assets/pi-working-phrase-demo.mp4",
		"image": "https://raw.githubusercontent.com/brandonmathis/pi-working-phrase/main/docs/assets/pi-working-phrase-demo.png"
	},
	"files": [
		"src/",
		"README.md",
		"LICENSE",
		"CHANGELOG.md",
		"CONTRIBUTING.md",
		"docs/",
		"scripts/"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"pack:check": "npm pack --dry-run",
		"video:demo": "tsx scripts/demo-working-phrase.ts",
		"video:image": "node scripts/update-video.mjs --skip-record",
		"video:update": "node scripts/update-video.mjs"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "0.74.0",
		"@eslint/js": "^10.0.1",
		"@types/node": "^25.6.0",
		"eslint": "^10.3.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.6.0",
		"prettier": "^3.5.3",
		"tsx": "^4.22.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.2",
		"vitest": "^4.1.5"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	}
}
